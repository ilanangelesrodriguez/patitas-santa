{
  "info": {
    "name": "Patitas del Santa - Pruebas Semana 10",
    "_postman_id": "78d27199-17e2-4c9b-8969-b10ea11c2026",
    "description": "Importar, ejecutar en orden. Registra 3 dueños, 5 mascotas, 2 veterinarios y 4 citas en H2. Ejecutar de nuevo con H2 limpio para evitar DNI/colegiaturas duplicados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas futuras en hora ISO local, +7, +8, +9 y +10 días",
          "const now = new Date();",
          "[7,8,9,10].forEach((days, index) => {",
          "  const d = new Date(now.getTime() + days * 86400000);",
          "  const pad = n => String(n).padStart(2,'0');",
          "  const fecha = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(10+index)}:00:00`;",
          "  pm.collectionVariables.set(`fecha${index+1}`, fecha);",
          "});"
        ]
      }
    }
  ],
